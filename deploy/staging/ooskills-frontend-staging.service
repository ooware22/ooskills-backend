[Unit]
Description=OOSkills frontend (STAGING) — Next.js on 127.0.0.1:3001
After=network.target

[Service]
User=ooskills
Group=ooskills
WorkingDirectory=/var/www/ooskills-staging/ooskills-frontend
Environment=NODE_ENV=production
Environment=PORT=3001
ExecStart=/usr/bin/env npm run start -- -p 3001 -H 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
