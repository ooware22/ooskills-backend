# =============================================================================
# OOSkills — STAGING backend environment
#
# Copy to /var/www/ooskills-staging/ooskills-backend/.env on the VPS and fill
# in every value. Never point any of these at production resources — staging
# runs migrations and deletes files freely.
# =============================================================================

ENVIRONMENT=staging
DEBUG=False
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(50))">

# --- Hostnames ---------------------------------------------------------------
EXTRA_ALLOWED_HOSTS=api-staging.ooskills.com
EXTRA_CORS_ORIGINS=https://staging.ooskills.com
CSRF_TRUSTED_ORIGINS=https://api-staging.ooskills.com
FRONTEND_URL=https://staging.ooskills.com

# --- Database: a SEPARATE Supabase project (e.g. "ooskills-staging") --------
# Staging runs `migrate` on every deploy. If this points at production, a
# half-finished migration on the staging branch will change the prod schema.
# Use the POOLER string (Supabase → Connect → Transaction pooler), like prod does:
#   DB_HOST = aws-<n>-<region>.pooler.supabase.com   DB_PORT = 6543
#   DB_USER = postgres.<project-ref>                 (NOT plain "postgres")
# The direct host db.<ref>.supabase.co is IPv6-only and often unreachable from a VPS.
# Enter the password WITHOUT the [ ] brackets that Supabase's template shows.
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=6543
DB_SSLMODE=require

# Supabase API keys — from the SAME staging project as the database above
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Payments: Chargily TEST mode only ---------------------------------------
CHARGILY_URL=https://pay.chargily.net/test/api/v2/
CHARGILY_KEY=<test public key>
CHARGILY_SECRET=<test secret key>
# Must stay empty on servers — otherwise webhooks are sent to the ngrok tunnel.
NGROK_URL=

# --- File storage: separate R2 buckets ---------------------------------------
# With this prefix the code uses staging-audios, staging-images, ... so it can
# never read or delete production files. Create those 5 buckets first.
R2_BUCKET_PREFIX=staging-
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_AUDIOS=https://pub-<hash>.r2.dev
R2_PUBLIC_URL_IMAGES=https://pub-<hash>.r2.dev
R2_PUBLIC_URL_MATERIALS=https://pub-<hash>.r2.dev
R2_PUBLIC_URL_DIAPOSITIVE=https://pub-<hash>.r2.dev
R2_PUBLIC_URL_AVATARS=https://pub-<hash>.r2.dev

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
# Contact-form notifications (reply goes straight to the visitor).
CONTACT_NOTIFICATION_EMAIL=contact@ooskills.com
# Staging must not mail real people. Only these recipients receive mail
# ("@domain" = whole domain, or exact addresses); everything else is dropped.
EMAIL_RECIPIENT_ALLOWLIST=@ooskills.com

# --- Rate limiting -------------------------------------------------------------
# Reverse proxies in front of gunicorn (Cloudflare + nginx = 2). Without it,
# per-IP limits can be bypassed by sending a forged X-Forwarded-For header.
NUM_PROXIES=2
# Shared cache. Without Redis each gunicorn worker counts requests on its own,
# so every limit is multiplied by the number of workers. Uncomment only once a
# Redis server is really running: an unreachable Redis disables the limits.
# REDIS_URL=redis://127.0.0.1:6379/1

# --- Social login: add the staging URLs as allowed origins / redirects -------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Version of the terms / privacy policy users accept at sign-up (stored on
# each account). Change it whenever the published texts change.
TERMS_VERSION=2026-11-09
